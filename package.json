{
  "name": "stationeersprints",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "vitest run && oxlint && tsc -b",
    "extract": "node tools/extract/extract.ts",
    "db:migrate:local": "wrangler d1 migrations apply stationeersprints --local",
    "db:migrate": "wrangler d1 migrations apply stationeersprints --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "html-to-image": "^1.11.13",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-xml-parser": "^5.11.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
